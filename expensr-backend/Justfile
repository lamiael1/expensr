# Levantar el backend en modo desarrollo
dev:
    uv run uvicorn app.main:app --reload --port 8000

# Revisar la calidad de código con el linter
lint:
    uv run ruff check .

# Formatear el código automáticamente
format:
    uv run ruff format .

# Verificación completa antes de hacer push (lint + formato sin modificar)
check:
    uv run ruff check .
    uv run ruff format --check .
