# Copia este archivo a .env y rellena los valores reales.
# El .env NUNCA se sube al repositorio.

# Clave de la API de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=pon_aqui_tu_clave

# Conexión a PostgreSQL (el docker-compose.yml de la raíz usa estos valores)
DATABASE_URL=postgresql+psycopg://expensr:expensr@localhost:5432/expensr

# IBM BAW: Process REST API (monitoreo). Si se dejan vacías, el monitor
# marca BAW como "no configurado" y sigue funcionando con el resto.
BAW_BASE_URL=
BAW_USER=
BAW_PASSWORD=
# Ruta al certificado de la CA de BAW si usa uno autofirmado (opcional).
BAW_CA_BUNDLE=

# Appian: Web API listActiveInstances (monitoreo). Autenticación con API key.
APPIAN_BASE_URL=
APPIAN_API_KEY=
