# Copia este archivo a expensr-backend/.env y completa los valores del entorno.
# Este archivo de ejemplo no contiene credenciales reales.
# Nunca subas expensr-backend/.env al repositorio.

# Gemini: se usa para el OCR de facturas y el chatbot.
GEMINI_API_KEY=pon_aqui_tu_clave

# PostgreSQL para ejecución local del backend fuera de Docker.
# Docker Compose y Kubernetes sustituyen esta URL por la de su propia base de datos.
DATABASE_URL=postgresql+psycopg://expensr:expensr@localhost:5432/expensr
DEMO_EMPLOYEE=empleado_007

# IBM BAW: inicio de ExpenseValidation y llamadas a Process REST API.
BAW_BASE_URL=https://baw.habber.com:9443
BAW_USER=
BAW_PASSWORD=
BAW_BPD_ID=25.8b9e9886-b2f1-499d-923f-471e8ddde1c8
BAW_PROCESS_APP_ID=2066.4c8a44f8-a99d-43d4-9870-749789c4e209

# En Docker Compose se monta el certificado en esta ruta.
# Para desarrollo local con Uvicorn, usa la ruta local del certificado o deja vacío.
BAW_CA_BUNDLE=/run/certs/baw-ca.pem

# Compatibilidad del cliente de monitoreo con la cadena de certificados legacy de BAW.
BAW_ALLOW_LEGACY_CERTS=true

# Appian: consulta de instancias para monitoreo.
# Appian está pendiente de integración completa.
APPIAN_BASE_URL=
APPIAN_API_KEY=
